  "running": false,
  "shader": "\nattribute vec4 aSeed;\nattribute float aKind;\nuniform float uTime;\nuniform vec3 uFocus;\nuniform vec3 uVolume;\nuniform float uScale;\nuniform float uReduced;\nuniform vec3 uZones[2];\nuniform vec4 uPool;\nvarying vec4 vColor;\nvarying float vPetal;\nvarying float vAngle;\n#include <fog_pars_vertex>\n\nvec3 wrapAround(vec3 local) {\n  vec3 p = local - uFocus;\n  p = mod(p + 0.5 * uVolume, uVolume) - 0.5 * uVolume;\n  return uFocus + p;\n}\n\nvoid main() {\n  vec3 world;\n  float size;\n  vec3 tint;\n  float alpha;\n  float kept = 1.0;\n  vPetal = 0.0;\n  vAngle = 0.0;\n  if (aKind < 0.5) {\n    // Golden pollen: lazy upward drift with a slow lateral sway, glinting as it turns.\n    vec3 base = aSeed.xyz * uVolume;\n    base.x += sin(uTime * (0.25 + aSeed.w * 0.3) + aSeed.y * 40.0) * 1.6 + uTime * 0.12;\n    base.z += cos(uTime * (0.2 + aSeed.w * 0.3) + aSeed.x * 40.0) * 1.6;\n    world = wrapAround(vec3(base.x, 0.0, base.z));\n    world.y = uFocus.y + 0.4 + mod(aSeed.y * uVolume.y + uTime * (0.08 + aSeed.w * 0.1), uVolume.y);\n    size = 0.06 + aSeed.w * 0.05;\n    tint = mix(vec3(1.0, 0.82, 0.38), vec3(1.0, 0.92, 0.6), aSeed.z);\n    alpha = (0.45 + 0.55 * (0.5 + 0.5 * sin(uTime * (1.2 + aSeed.x * 2.0) + aSeed.z * 50.0))) * 0.8;\n    kept = step(aSeed.w, mix(1.0, 0.35, uReduced));\n  } else if (aKind < 1.5) {\n    // Firefly: a wandering green-gold spark that blinks slowly near the ground.\n    vec3 base = aSeed.xyz * uVolume;\n    base.x += sin(uTime * (0.35 + aSeed.w * 0.4) + aSeed.y * 30.0) * 2.2;\n    base.z += cos(uTime * (0.3 + aSeed.w * 0.4) + aSeed.x * 30.0) * 2.2;\n    world = wrapAround(vec3(base.x, 0.0, base.z));\n    world.y = uFocus.y + 0.5 + aSeed.y * 2.6 + sin(uTime * 0.9 + aSeed.z * 20.0) * 0.4;\n    size = 0.1 + aSeed.w * 0.05;\n    tint = vec3(0.78, 1.0, 0.42);\n    float blink = smoothstep(0.35, 0.9, 0.5 + 0.5 * sin(uTime * (0.7 + aSeed.x * 0.8) + aSeed.z * 60.0));\n    alpha = blink * 0.9;\n    kept = 1.0 - uReduced;\n  } else if (aKind < 3.5) {\n    // Black Sap spore: a dark mote rising slowly over the blighted hollow or the Memory Pool arena, fading in and out of sight as it climbs.\n    vec3 zone = aSeed.w < 0.5 ? uZones[0] : uZones[1];\n    float angle = aSeed.x * 6.2832;\n    float radius = sqrt(aSeed.y) * zone.z;\n    float rise = fract(aSeed.z + uTime * (0.05 + aSeed.y * 0.05));\n    world = vec3(zone.x + cos(angle) * radius + sin(uTime * 0.3 + aSeed.z * 20.0) * 0.5, 0.2 + rise * 3.2, zone.y + sin(angle) * radius + cos(uTime * 0.25 + aSeed.x * 20.0) * 0.5);\n    size = 0.15 + aSeed.w * 0.07;\n    // Sickly ochre spores over the hollow, bruised violet ones over the Memory Pool arena.\n    tint = mix(vec3(0.9, 0.74, 0.3), vec3(0.66, 0.44, 0.95), step(0.5, aSeed.w));\n    alpha = sin(rise * 3.1416) * 0.85;\n    kept = step(aSeed.z, mix(1.0, 0.35, uReduced));\n  } else if (aKind < 4.5) {\n    // Heart-light ember: a warm amber spark lifting off the Memory Pool's surface.\n    float rise = fract(aSeed.z + uTime * (0.07 + aSeed.w * 0.06));\n    float angle = aSeed.x * 6.2832;\n    float radius = sqrt(aSeed.y);\n    world = vec3(uPool.x + cos(angle) * radius * uPool.z + sin(uTime * 0.4 + aSeed.x * 40.0) * 0.4, 0.1 + rise * 4.0, uPool.y + sin(angle) * radius * uPool.w);\n    size = 0.1 + aSeed.w * 0.06;\n    tint = mix(vec3(1.0, 0.68, 0.22), vec3(1.0, 0.86, 0.45), aSeed.y);\n    alpha = sin(rise * 3.1416) * 0.9;\n    kept = 1.0 - uReduced;\n  } else {\n    // Petal: slow fall, flutter and tumbling; warm pink and cream.\n    float fall = 0.28 + aSeed.w * 0.3;\n    vec3 base = aSeed.xyz * uVolume;\n    base.y = mod(base.y - uTime * fall, uVolume.y);\n    base.x += sin(uTime * 0.7 + aSeed.z * 31.0) * 1.3 + uTime * 0.2;\n    base.z += cos(uTime * 0.55 + aSeed.x * 27.0) * 1.3;\n    world = wrapAround(vec3(base.x, 0.0, base.z));\n    world.y = uFocus.y + 0.3 + base.y;\n    size = 0.13 + aSeed.y * 0.07;\n    tint = mix(vec3(1.0, 0.7, 0.76), vec3(1.0, 0.93, 0.8), step(0.5, fract(aSeed.x * 7.0)));\n    alpha = 0.85;\n    kept = 1.0 - uReduced;\n    vPetal = 1.0;\n    vAngle = aSeed.x * 6.2832 + uTime * (0.5 + aSeed.y);\n  }\n  vec4 mvPosition = viewMatrix * vec4(world, 1.0);\n  // Nothing may drift into the camera path: fade out inside 11 m of the camera and cull inside 8 m.\n  float cameraDistance = length(world - cameraPosition);\n  alpha *= smoothstep(8.0, 11.0, cameraDistance);\n  kept *= step(8.0, cameraDistance);\n  gl_Position = projectionMatrix * mvPosition;\n  gl_PointSize = min(size * uScale / max(-mvPosition.z, 0.1), 36.0);\n  vColor = vec4(tint, alpha);\n  if (kept < 0.5) {\n    gl_Position = vec4(2.0, 2.0, 2.0, 1.0);\n    gl_PointSize = 0.0;\n  }\n  #include <fog_vertex>\n}",
  "note": "Actual renderer uniforms and root/camera sampled on RAF. Firefly world height derived from the live vertex shader; no shader or state replacement."
